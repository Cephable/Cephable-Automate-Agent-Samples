{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "noUncheckedIndexedAccess": false,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"],
        // Node 22+ runs TypeScript directly via --experimental-strip-types, so the .ts extensions in
        // our own imports are real runtime paths, not a build-tool convention.
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
