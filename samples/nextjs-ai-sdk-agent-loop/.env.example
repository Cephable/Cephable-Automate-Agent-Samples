# Copy to .env.local. Never commit the real file.
#
# The key is read on the server only. Do NOT give it a NEXT_PUBLIC_ name - anything
# public is compiled into the browser bundle, and this key is a password: it can run
# the assistant with the user's file access, their apps and their connected accounts.
CEPHABLE_AUTOMATE_KEY=paste-the-key-from-the-extension-detail-view

# Optional: skip the 4317-4328 port sweep by pinning the endpoint.
# CEPHABLE_ENDPOINT=http://127.0.0.1:4317
