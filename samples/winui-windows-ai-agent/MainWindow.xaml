<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CephableDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CephableDesk"
    xmlns:services="using:CephableDesk.Services"
    Title="Cephable Desk - on-device agent">

    <Grid Padding="20" RowSpacing="14" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status: which local model, which accelerator, whether Windows AI is available -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Cephable Desk" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Three on-device AI systems, no network: Windows OCR reads what you paste, Phi Silica summarizes and rewrites it, and Cephable's agent decides what to do."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                <InfoBadge x:Name="CephableBadge" Value="0" Visibility="Collapsed" />
                <TextBlock x:Name="CephableStatus" Text="Connecting to Cephable..." Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="WindowsAiStatus" Text="" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- The pasted document -->
        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Pasted document" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="ScreenTextPreview"
                        Text="Paste an image (Ctrl+V) or drop a PNG here. Windows OCR will read it on this device."
                        TextWrapping="Wrap"
                        MaxLines="4"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="PasteButton" Content="Paste image" Click="OnPasteClicked" />
                    <Button x:Name="OpenButton" Content="Open..." Click="OnOpenClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transcript and notes -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" x:Name="TranscriptScroller">
                <ItemsControl x:Name="Transcript" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TranscriptEntry">
                            <Border
                                Margin="0,0,0,6"
                                Padding="10,7"
                                CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="0,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Kind}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border
                Grid.Column="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Notes the agent saved" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="NotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:SavedNote">
                                <StackPanel Margin="0,0,0,10" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Composer -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                x:Name="PromptBox"
                PlaceholderText="Ask the agent to do something with what you pasted..."
                KeyDown="OnPromptKeyDown"
                AcceptsReturn="False" />
            <Button Grid.Column="1" x:Name="RunButton" Content="Run" Style="{StaticResource AccentButtonStyle}"
                    Click="OnRunClicked" />
            <Button Grid.Column="2" x:Name="StopButton" Content="Stop" Click="OnStopClicked" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
