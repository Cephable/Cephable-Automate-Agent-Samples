<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <!-- Runs on 19041+; the Windows AI features below check their own availability at runtime. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CephableDesk</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!--
      Unpackaged, so `dotnet run` works without deploying an MSIX. Note that some Windows AI features
      want package identity depending on the Windows build - the app checks readiness and degrades
      rather than crashing. See the README.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!--
      1.7 is what these Windows AI APIs were verified against:
        Microsoft.Windows.AI.Text    - LanguageModel (Phi Silica), TextSummarizer, TextRewriter
        Microsoft.Windows.AI.Imaging - TextRecognizer (on-device OCR)
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\notes.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
